{
  "name": "commerce-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "build": "tsc -p tsconfig.server.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/server/apps/server/index.js",
    "import:product": "tsx scripts/import-product.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.4",
    "fflate": "0.8.3",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
