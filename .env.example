# Optional local model configuration. Leave disabled to run the deterministic flows.
COMMERCE_COPY_ENABLED=0
COMMERCE_IMAGE_ENABLED=0
COMMERCE_MARKET_AI_ENABLED=0

# Required only when explicitly enabling model-backed features.
DASHSCOPE_API_KEY=
COMMERCE_BAILIAN_WORKSPACE_ID=
COMMERCE_COPY_MODEL=
COMMERCE_TEXT_FAST_MODEL=
COMMERCE_TEXT_REASONING_MODEL=
COMMERCE_IMAGE_MODEL=

# Optional market monitoring schedule, in days. Empty/0 keeps scheduled monitoring off.
COMMERCE_MARKET_MONITORING_SCHEDULE_DAYS=0
