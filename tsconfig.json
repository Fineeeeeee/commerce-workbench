{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "types": ["node"],
    "noEmit": true
  },
  "include": ["apps", "packages", "scripts", "tests"]
}
